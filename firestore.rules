rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user can read and write only their own document and subcollections under users/{userId}
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Research Event Log collection:
    // Allow appending and reading telemetry events (non-PII research data).
    // Updating and deleting raw logs is strictly forbidden to preserve data integrity.
    match /events/{eventId} {
      allow create, read: if true;
      allow update, delete: if false;
    }

    // Default deny for any other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
